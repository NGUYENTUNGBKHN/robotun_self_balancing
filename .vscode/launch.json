{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        /* ************************************** */
        /*      Bootloader                       */
        /* ************************************** */
        {   // Bootloader
            "name": "Bootloader (Jlink)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/4_CODE/stm32f1/_build/Bootloader/boot.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "STM32F103C8",
            "svdFile": "${workspaceFolder}/4_CODE/stm32f1/svd/stm32f103.svd", // <--- IMPORTANT: Path to your SVD file
            "interface": "swd",
            "configFiles": [
                "${workspaceFolder}/4_CODE/stm32f1/svd/stm32f1-swd.cfg"
            ],
            "searchDir": [
                "${env:OPENOCD_SCRIPTS}", 
            ],
            "runToEntryPoint": "main",
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 72000000,
                "swoFrequency": 2000000,
                "source": "probe",
                "decoders": [{ "type": "console", "label": "ITM", "port": 0 }]
            }
        },
        /* ************************************** */
        /*      Application                       */
        /* ************************************** */
        {
            "name": "Application (J-Link)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/4_CODE/stm32f1/_build/Application/app.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "STM32F103C8",
            "interface": "swd",
            "svdFile": "${workspaceFolder}/4_CODE/stm32f1/svd/stm32f103.svd",
            "loadFiles": [
                "${workspaceFolder}/4_CODE/stm32f1/_build/Bootloader/boot.elf",
                "${workspaceFolder}/4_CODE/stm32f1/_build/Application/app.elf"
            ],
            "symbolFiles": [
                "${workspaceFolder}/4_CODE/stm32f1/_build/Bootloader/boot.elf",
                "${workspaceFolder}/4_CODE/stm32f1/_build/Application/app.elf"
            ],
            "serverpath": "C:/Program Files/SEGGER/JLink_V810d/JLinkGDBServerCL.exe",
            "armToolchainPath": "D:/Toolchain_2/bin",
            "runToEntryPoint": "boot_main",
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 72000000,
                "swoFrequency": 2000000,
                "source": "probe",
                "decoders": [{ "type": "console", "label": "ITM", "port": 0 }]
            }
        },
    ]
}