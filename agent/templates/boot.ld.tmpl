/*
****************************************************************************************************************
 * Linker script for {{MCU}} Bootloader partition
 * Flash Total: {{FLASH_SIZE}}
 *   - Bootloader: {{BOOT_START}} ({{BOOT_SIZE}})
 *   - Staging DWL: {{DWL_START}} ({{DWL_SIZE}})
 * SRAM: {{SRAM_START}} ({{SRAM_SIZE}})
****************************************************************************************************************
*/

ENTRY(Reset_Handler)

_estack = ORIGIN(RAM) + LENGTH(RAM);

_Min_Heap_Size  = 0x200;
_Min_Stack_Size = 0x400;

MEMORY
{
  RAM       (xrw) : ORIGIN = {{SRAM_START}}, LENGTH = {{SRAM_SIZE}}
  FLASH     (rx)  : ORIGIN = {{BOOT_START}}, LENGTH = {{BOOT_SIZE}}
  DWL_FLASH (rx)  : ORIGIN = {{DWL_START}}, LENGTH = {{DWL_SIZE}}
}

SECTIONS
{
  .isr_vector :
  {
    . = ALIGN(4);
    KEEP(*(.isr_vector))
    . = ALIGN(4);
  } >FLASH

  .text :
  {
    . = ALIGN(4);
    *(.text)
    *(.text*)
    *(.glue_7)
    *(.glue_7t)
    *(.eh_frame)
    KEEP (*(.init))
    KEEP (*(.fini))
    . = ALIGN(4);
    _etext = .;
  } >FLASH

  .rodata :
  {
    . = ALIGN(4);
    *(.rodata)
    *(.rodata*)
    . = ALIGN(4);
  } >FLASH

  _sidata = LOADADDR(.data);

  .data :
  {
    . = ALIGN(4);
    _sdata = .;
    *(.data)
    *(.data*)
    *(.RamFunc)
    *(.RamFunc*)
    . = ALIGN(4);
    _edata = .;
  } >RAM AT> FLASH

  .entry_dwl {{DWL_START}} :
  {
    KEEP(*(.entry_dwl))
  } >DWL_FLASH

  . = ALIGN(4);
  .bss :
  {
    _sbss = .;
    __bss_start__ = _sbss;
    *(.bss)
    *(.bss*)
    *(COMMON)
    . = ALIGN(4);
    _ebss = .;
    __bss_end__ = _ebss;
  } >RAM

  ._user_heap_stack :
  {
    . = ALIGN(8);
    PROVIDE ( end  = . );
    PROVIDE ( _end = . );
    . = . + _Min_Heap_Size;
    . = . + _Min_Stack_Size;
    . = ALIGN(8);
  } >RAM

  .ARM.attributes 0 : { *(.ARM.attributes) }

  __RAM_segment_used_end__ = .;
}
