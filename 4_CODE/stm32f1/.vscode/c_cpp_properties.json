{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/Common/**",
                "${workspaceFolder}/Middleware/**",
                "${workspaceFolder}/Application",
                "${workspaceFolder}/Bootloader",
                "${workspaceFolder}/Bootloader/boot_process",
                "${workspaceFolder}/Bootloader/boot_process/operation",
                "${workspaceFolder}/Middleware/Acc_Gyro",
                "${workspaceFolder}/Middleware/Encoder",
                "${workspaceFolder}/Middleware/Motor",
                "${workspaceFolder}/Middleware/PID",
                "${workspaceFolder}/OS/threadx/common/inc",
                "${workspaceFolder}/OS/threadx/ports/cortex_m3/gnu/inc",
                "${workspaceFolder}/SDK/Core/Include",
                "${workspaceFolder}/SDK/Device/Inc",
                "${workspaceFolder}/SDK/Driver/hal",
                "${workspaceFolder}/SDK/Driver/hal/Inc"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "STM32F103xB"
            ],
            "cStandard": "gnu99",
            "cppStandard": "gnu++98",
            "intelliSenseMode": "gcc-arm",
            "compilerPath": "${env:GCC_TOOLCHAIN_EXECUTE}"
        }
    ],
    "version": 4
}